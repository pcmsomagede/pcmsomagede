---
import MainLayout from '../layouts/MainLayout.astro';
import { site, sitePath } from '../data/site';
---
<MainLayout title="Organisasi">
  <main class="org-page">
    <section class="org-hero"><div class="container"><div class="hero-badge">EKOSISTEM GERAKAN</div><h1>Struktur yang bisa dilihat, bukan sekadar daftar.</h1><p>PCM Somagede ditampilkan sebagai peta gerakan: pimpinan di pusat, majelis dan unsur pendukung mengalir ke bawah, dengan setiap simpul bisa dibuka untuk melihat fungsi dan programnya.</p><div class="hero-pills"><span>● Pimpinan</span><span>◆ Majelis</span><span>✦ Ortom</span><span>▣ Amal Usaha</span></div></div></section>
    <section class="section"><div class="container">
      <div class="org-map" aria-label="Struktur organisasi PCM Somagede">
        <div class="org-root"><span class="node-icon">◎</span><div><small>PIMPINAN CABANG</small><h2>PCM Somagede</h2><p>Kabupaten Banyumas</p></div><span class="pulse"></span></div>
        <div class="connector"></div>
        <div class="leader-row">
          <article class="leader-card featured"><div class="avatar">BB</div><div><span class="role">KETUA</span><h3>Drs. Bambang Budiarso</h3><p>Ketua Pimpinan Cabang Muhammadiyah Somagede</p></div><span class="card-glow"></span></article>
          <article class="leader-card vacant"><div class="avatar">＋</div><div><span class="role">SEKRETARIAT</span><h3>Struktur Sekretariat</h3><p>Tempat pengelolaan surat, notulensi, arsip, agenda dan layanan administrasi.</p></div></article>
          <article class="leader-card vacant"><div class="avatar">＋</div><div><span class="role">KEUANGAN</span><h3>Struktur Keuangan</h3><p>Ruang tata kelola pemasukan, pengeluaran, laporan dan pertanggungjawaban organisasi.</p></div></article>
        </div>

        <div class="branch-line"><span></span><span></span><span></span></div>
        <div class="org-clusters">
          <article class="cluster blue"><header><span>◆</span><div><small>MAJELIS</small><h3>Majelis Tarjih &amp; Tajdid</h3></div></header><p>Kajian, penguatan pemahaman keislaman dan pengembangan tradisi ilmu.</p><button type="button" class="cluster-toggle">Lihat peran <b>＋</b></button><div class="cluster-more"><strong>Ruang kerja</strong><ul><li>Kajian dan pengembangan pemikiran keislaman</li><li>Pembinaan pemahaman warga</li><li>Materi belajar dan publikasi</li></ul></div></article>
          <article class="cluster violet"><header><span>✦</span><div><small>MAJELIS</small><h3>Majelis Dikdasmen &amp; PNF</h3></div></header><p>Pendidikan, pembinaan sekolah dan penguatan ekosistem belajar Muhammadiyah.</p><button type="button" class="cluster-toggle">Lihat peran <b>＋</b></button><div class="cluster-more"><strong>Ruang kerja</strong><ul><li>Pendidikan dan pembinaan sekolah</li><li>Kaderisasi pendidik</li><li>Pengembangan program pendidikan</li></ul></div></article>
          <article class="cluster amber"><header><span>◇</span><div><small>MAJELIS</small><h3>Majelis Tabligh</h3></div></header><p>Dakwah, kajian, khutbah, kultum dan penguatan komunikasi keumatan.</p><button type="button" class="cluster-toggle">Lihat peran <b>＋</b></button><div class="cluster-more"><strong>Ruang kerja</strong><ul><li>Kajian rutin</li><li>Khutbah dan kultum</li><li>Penguatan dai dan materi dakwah</li></ul></div></article>
          <article class="cluster teal"><header><span>♥</span><div><small>MAJELIS</small><h3>Majelis Sosial &amp; Kesejahteraan</h3></div></header><p>Pelayanan sosial, kepedulian warga, zakat, infak, sedekah dan kebencanaan.</p><button type="button" class="cluster-toggle">Lihat peran <b>＋</b></button><div class="cluster-more"><strong>Ruang kerja</strong><ul><li>Pelayanan sosial</li><li>Pengelolaan kepedulian dan bantuan</li><li>Kolaborasi layanan umat</li></ul></div></article>
          <article class="cluster pink"><header><span>☼</span><div><small>ORTOM</small><h3>Organisasi Otonom</h3></div></header><p>Ruang kaderisasi dan pengembangan generasi muda melalui unsur otonom Muhammadiyah.</p><button type="button" class="cluster-toggle">Lihat unsur <b>＋</b></button><div class="cluster-more"><strong>Ekosistem</strong><ul><li>KOKAM</li><li>Hizbul Wathan</li><li>Unsur kader dan kepemudaan lainnya</li></ul></div></article>
          <article class="cluster green"><header><span>▣</span><div><small>AMAL USAHA</small><h3>Pendidikan &amp; Layanan</h3></div></header><p>Amal usaha menjadi simpul pelayanan nyata bagi masyarakat Somagede.</p><button type="button" class="cluster-toggle">Lihat unsur <b>＋</b></button><div class="cluster-more"><strong>Yang ditampilkan</strong><ul><li>SMK Muhammadiyah Somagede</li><li>TK Bustanul Athfal</li><li>Layanan sosial dan pendidikan</li></ul></div></article>
        </div>
      </div>

      <section class="org-rhythm"><div><span class="eyebrow">Ritme organisasi</span><h2>Gerakan yang punya denyut.</h2><p>Empat jalur kerja ini menghubungkan struktur dengan kegiatan sehari-hari: belajar, bermusyawarah, melayani dan mengarsipkan.</p></div><div class="rhythm-grid"><a href="#kajian"><b>01</b><span>Kajian</span><small>Belajar &amp; berdiskusi</small></a><a href="#rapat"><b>02</b><span>Rapat</span><small>Musyawarah &amp; evaluasi</small></a><a href="#anggota"><b>03</b><span>Keanggotaan</span><small>Kader &amp; warga</small></a><a href="#ortom"><b>04</b><span>Pengabdian</span><small>Amal usaha &amp; sosial</small></a></div></section>

      <div class="org-sections">
        <article id="kajian"><span class="eyebrow">01 · Kajian</span><h2>Kajian Rutin</h2><p>Ruang belajar Islam, dialog dan penguatan pemahaman warga. Jadwal dan dokumentasi dapat dikelola melalui KabarMu.</p></article>
        <article id="rapat"><span class="eyebrow">02 · Tata Kelola</span><h2>Rapat Rutin</h2><p>Rapat pimpinan dan koordinasi program menjadi ruang evaluasi, perencanaan dan tindak lanjut gerakan.</p></article>
        <article id="anggota"><span class="eyebrow">03 · Keanggotaan</span><h2>Kartu Anggota Muhammadiyah</h2><p>Ruang layanan keanggotaan dan registrasi warga Muhammadiyah di wilayah kerja PCM Somagede.</p><a class="button button-primary" href={sitePath('/kontak')}>Tanyakan Registrasi →</a></article>
        <article id="ortom"><span class="eyebrow">04 · Ekosistem</span><h2>Organisasi Otonom &amp; Amal Usaha</h2><p>Struktur visual di atas menghubungkan unsur kaderisasi, kepanduan, sosial dan pendidikan agar pengunjung memahami ekosistem gerakan dalam satu pandangan.</p></article>
      </div>
    </div></section>
  </main>
</MainLayout>
<script>
document.querySelectorAll<HTMLButtonElement>('.cluster-toggle').forEach((button)=>button.addEventListener('click',()=>{const card=button.closest<HTMLElement>('.cluster');if(!card)return;const open=card.classList.toggle('open');button.setAttribute('aria-expanded',String(open));const b=button.querySelector('b');if(b)b.textContent=open?'−':'＋'}));
</script>
<style>
.org-page{background:#f7f9fc}.org-hero{padding:76px 0 52px;color:#fff;background:radial-gradient(circle at 82% 18%,rgba(255,214,63,.28),transparent 24%),radial-gradient(circle at 15% 80%,rgba(39,213,194,.22),transparent 26%),linear-gradient(125deg,#041b42 0%,#0757a6 52%,#0a8f91 100%);overflow:hidden;position:relative}.org-hero::after{content:"";position:absolute;width:480px;height:480px;border:1px solid rgba(255,255,255,.13);border-radius:50%;right:-180px;bottom:-330px}.hero-badge{display:inline-flex;padding:8px 12px;border-radius:999px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);font-size:.72rem;font-weight:950;letter-spacing:.12em}.org-hero h1{max-width:820px;margin:14px 0 12px;font-size:clamp(2.5rem,6vw,5rem);line-height:.96;letter-spacing:-.045em}.org-hero p{max-width:760px;color:#e1efff;font-size:1.05rem}.hero-pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.hero-pills span{padding:8px 11px;border-radius:999px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.14);font-size:.75rem;font-weight:850}.org-map{position:relative;padding-top:8px}.org-root{position:relative;display:flex;align-items:center;gap:16px;width:min(520px,100%);margin:0 auto;padding:20px 24px;border-radius:26px;color:#fff;background:linear-gradient(135deg,#073a80,#0c8d8c);box-shadow:0 22px 50px rgba(7,52,113,.18);overflow:hidden}.org-root::after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-60px;top:-70px;background:rgba(255,255,255,.09)}.node-icon{display:grid;place-items:center;width:56px;height:56px;border-radius:18px;background:rgba(255,255,255,.13);font-size:1.7rem}.org-root small,.leader-card .role,.cluster small{display:block;font-size:.65rem;letter-spacing:.12em;font-weight:950;opacity:.75}.org-root h2{margin:.15rem 0;font-size:1.65rem}.org-root p{margin:0;color:#d9efff}.pulse{margin-left:auto;width:10px;height:10px;border-radius:50%;background:#ffdb43;box-shadow:0 0 0 7px rgba(255,219,67,.15);animation:pulse 2s infinite}.connector{width:2px;height:44px;margin:auto;background:linear-gradient(#0b5aaa,#0aa6a0)}.leader-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.leader-card{position:relative;display:flex;gap:13px;padding:20px;border-radius:22px;background:#fff;border:1px solid #dce7f3;box-shadow:0 12px 28px rgba(7,31,77,.07);overflow:hidden}.leader-card.featured{border-top:5px solid #0b5aaa}.leader-card.vacant{border-top:5px solid #dce7f3}.leader-card .avatar{flex:0 0 52px;width:52px;height:52px;border-radius:16px;display:grid;place-items:center;background:#eef6ff;color:#0b5aaa;font-weight:950}.leader-card.vacant .avatar{background:#f5f7fa;color:#8391a5}.leader-card h3{margin:.25rem 0 .25rem;font-size:1.05rem}.leader-card p{margin:0;color:#6a7b91;font-size:.82rem;line-height:1.5}.leader-card .role{color:#0b5aaa}.card-glow{position:absolute;width:100px;height:100px;border-radius:50%;right:-50px;bottom:-50px;background:rgba(11,90,170,.08)}.branch-line{height:42px;margin:0 auto;position:relative}.branch-line::before{content:"";position:absolute;left:16.66%;right:16.66%;top:0;border-top:2px solid #b7d0ea}.branch-line span{position:absolute;top:-1px;width:2px;height:42px;background:#b7d0ea}.branch-line span:nth-child(1){left:16.66%}.branch-line span:nth-child(2){left:50%}.branch-line span:nth-child(3){right:16.66%}.org-clusters{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.cluster{padding:20px;border-radius:22px;background:#fff;border:1px solid #dce7f3;box-shadow:0 12px 30px rgba(7,31,77,.06);transition:transform .2s ease,box-shadow .2s ease}.cluster:hover{transform:translateY(-4px);box-shadow:0 22px 45px rgba(7,31,77,.1)}.cluster header{display:flex;gap:12px;align-items:center}.cluster header>span{display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:#eef6ff;color:#0b5aaa;font-weight:950}.cluster h3{margin:.2rem 0 0;font-size:1.05rem}.cluster p{color:#65768d;font-size:.86rem;min-height:56px}.cluster-toggle{width:100%;display:flex;justify-content:space-between;align-items:center;border:0;background:#f6f9fc;color:#254564;padding:10px 12px;border-radius:11px;font-weight:850;cursor:pointer}.cluster-more{display:none;padding-top:12px;color:#60718a;font-size:.82rem}.cluster-more ul{margin:.5rem 0 0;padding-left:1.1rem}.cluster.open .cluster-more{display:block}.cluster.open{outline:2px solid rgba(11,90,170,.1)}.cluster.violet{border-top:5px solid #9a78ff}.cluster.amber{border-top:5px solid #ffd64a}.cluster.teal{border-top:5px solid #10b6a7}.cluster.pink{border-top:5px solid #ff6ca8}.cluster.green{border-top:5px solid #57d39b}.cluster.blue{border-top:5px solid #54a9ff}.org-rhythm{margin-top:50px;padding:28px;border-radius:28px;background:linear-gradient(135deg,#061d46,#0a7f88);color:#fff;display:grid;grid-template-columns:.9fr 1.4fr;gap:26px;align-items:center}.org-rhythm h2{margin:.3rem 0 .5rem;font-size:2rem}.org-rhythm p{color:#d8eff8}.rhythm-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.rhythm-grid a{padding:15px;border-radius:17px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#fff}.rhythm-grid b{display:block;color:#ffda46;font-size:.7rem}.rhythm-grid span{display:block;font-weight:900;font-size:1.05rem}.rhythm-grid small{color:#cce6ef}.org-sections{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;margin-top:34px}.org-sections article{scroll-margin-top:120px;padding:25px;border-radius:20px;background:#fff;border:1px solid #dce7f3;box-shadow:0 10px 24px rgba(7,31,77,.05)}.org-sections h2{margin:.25rem 0 .5rem}.org-sections p{color:#65768d}.org-sections .button{margin-top:8px}@keyframes pulse{50%{box-shadow:0 0 0 11px rgba(255,219,67,0)}}@media(max-width:900px){.leader-row,.org-clusters{grid-template-columns:1fr 1fr}.org-rhythm{grid-template-columns:1fr}}@media(max-width:620px){.org-hero{padding:55px 0 38px}.org-hero h1{font-size:2.65rem}.leader-row,.org-clusters,.org-sections{grid-template-columns:1fr}.branch-line{display:none}.org-root{padding:17px}.org-rhythm{padding:21px}.rhythm-grid{grid-template-columns:1fr 1fr}}
</style>
