---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import { quranSurahs } from '../data/quran';

const books = [
  'Kode Indeks Surat Muhammadiyah','Tanya Jawab Agama Jilid 1','Tanya Jawab Agama Jilid 2','Tanya Jawab Agama Jilid 3','Tanya Jawab Agama Jilid 5','Tanya Jawab Agama Jilid 6','Tanya Jawab Agama Jilid 7','Tanya Jawab Agama Jilid 8','Buku Tuntunan Tabligh','Dua Menyemai Damai','Pedoman Keprotokolan Muhammadiyah','Himpunan Peraturan Organisasi Muhammadiyah 2022','Muhammadiyah Ahmad Dahlan Menemukan Kembali Otentitas Gerakan','Muhammadiyah dalam Perspektif Sejarah, Organisasi dan Sistem Nilai','Pedoman Tata Naskah Dinas Muhammadiyah','Percik Pemikiran Tokoh Muhammadiyah untuk Indonesia Berkemajuan','Tafsir Al Ma’un Abad II Muhammadiyah','Pedoman Masjid Muhammadiyah','Fikih Salat Berjamaah','Himpunan Putusan Tarjih Buku 1','AD/ART Muhammadiyah Tahun 2020','Pedoman Hidup Islami Warga Muhammadiyah','Tuntunan Perawatan Jenazah','Pedoman Pelaksanaan Perkaderan Muhammadiyah','Modul Baitul Arqam','Sistem Perkaderan Muhammadiyah','Panduan Dakwah Digital Muhammadiyah Era AI','Kosmologi Nuzulul Qur’an','Hikmah Ramadan','Fakta Sejarah dan Mitos Walisongo'
];
---
<MainLayout title="PustakaMu">
  <PageHero eyebrow="Belajar · Baca · Tumbuh" title="PustakaMu" description="Pusat belajar lokal PCM Somagede: Al Qur’anMu, buku, kitab, khutbah, kultum dan jalur belajar yang tersusun di dalam situs." />
  <main class="section"><div class="container">
    <section class="source-hero"><div><span class="eyebrow">Ruang baca lokal</span><h2>Satu halaman untuk mulai belajar.</h2><p>Tidak ada tombol yang melempar pengunjung keluar situs. Semua menu PustakaMu berhenti di halaman lokal ini.</p></div><div class="source-stats"><strong>114</strong><span>surah</span><strong>{books.length}</strong><span>judul katalog</span></div></section>
    <section id="quranmu" class="library-section"><div class="section-head"><div><span class="eyebrow">Al Qur’anMu</span><h2>114 Surah</h2><p>Indeks surah lokal dengan pencarian cepat. Struktur ini menjadi fondasi pembaca Al Qur’an offline.</p></div></div><div class="search-row"><input id="quran-search" type="search" placeholder="Cari nama surah, arti, atau nomor…"/><span id="quran-count">114 surah</span></div><div class="quran-grid" id="quran-grid">{quranSurahs.map((s)=><article class="quran-card" data-search={`${s.no} ${s.name} ${s.meaning} ${s.arabic}`}><div class="qnum">{s.no}</div><div><strong>{s.name}</strong><span class="arabic">{s.arabic}</span><small>{s.meaning} · {s.verses} ayat</small></div><span class="local-badge">Lokal</span></article>)}</div></section>
    <section id="bukumu" class="library-section"><div class="section-head"><div><span class="eyebrow">BukuMu</span><h2>Koleksi Buku &amp; Naskah</h2><p>Katalog lokal yang dapat diperluas melalui Editor Konten dan Media Center.</p></div></div><div class="search-row"><input id="book-search" type="search" placeholder="Cari judul buku…"/><span id="book-count">{books.length} koleksi</span></div><div class="book-grid" id="book-grid">{books.map((title)=><article class="book-card" data-search={title}><span class="book-mark">▤</span><div><span class="book-type">Buku / Naskah</span><h3>{title}</h3><span class="local-badge">Katalog lokal</span></div></article>)}</div></section>
    <section id="khutbah" class="feature-grid"><article class="feature-card amber"><span>✦</span><h2>Khutbah Jumat</h2><p>Ruang katalog naskah khutbah. Berkas yang sudah dimiliki dapat ditambahkan melalui panel admin.</p><a href="#bukumu">Lihat pustaka →</a></article><article class="feature-card pink"><span>☼</span><h2>Kultum</h2><p>Koleksi kultum akan tampil sebagai dokumen lokal ketika naskahnya sudah dimasukkan ke ArsipMu.</p><a href="#bukumu">Lihat pustaka →</a></article><article class="feature-card teal"><span>كتاب</span><h2>Kitab Kuning</h2><p>Roadmap belajar bertingkat dari membaca teks Arab, nahwu, sharaf, matan hingga syarah.</p><a href="#kitab">Lihat roadmap →</a></article></section>
    <section id="arab" class="study-grid"><article class="study-card blue"><span>ا ب ت</span><h2>Arab Dasar → Mahir</h2><p>Mulai dari huruf dan kosakata, lanjut percakapan, membaca, nahwu, sharaf dan latihan pemahaman.</p></article><article id="kitab" class="study-card gold"><span>كتاب</span><h2>Kitab Kuning Dasar → Mahir</h2><p>Tahap 1 membaca huruf dan harakat; tahap 2 kosakata dan tarkib; tahap 3 nahwu-sharaf; tahap 4 membaca matan; tahap 5 syarah dan diskusi.</p></article><article id="haditsmu" class="study-card teal"><span>حديث</span><h2>HaditsMu</h2><p>Ruang indeks referensi hadits lokal yang dapat diisi dari koleksi yang dimiliki organisasi.</p></article></section>
  </div></main>
</MainLayout>
<script>
const bind=(inputId,selector,countId,unit)=>{const i=document.querySelector(inputId),cards=[...document.querySelectorAll(selector)],c=document.querySelector(countId);const run=()=>{const q=(i?.value||'').toLowerCase().trim();let n=0;cards.forEach(x=>{const ok=!q||(x.getAttribute('data-search')||'').toLowerCase().includes(q);x.hidden=!ok;if(ok)n++});if(c)c.textContent=`${n} ${unit}`};i?.addEventListener('input',run)};bind('#quran-search','#quran-grid .quran-card','#quran-count','surah');bind('#book-search','#book-grid .book-card','#book-count','koleksi');
</script>
<style>
.source-hero{display:flex;justify-content:space-between;gap:25px;align-items:center;padding:34px;border-radius:28px;background:linear-gradient(135deg,#071f4d,#0b4aa2,#0ea7a3);color:#fff;box-shadow:0 22px 55px rgba(7,31,77,.16)}.source-hero h2{margin:.35rem 0 .5rem;font-size:clamp(2rem,4vw,3.1rem)}.source-hero p{max-width:760px;color:#e7f2ff}.source-stats{display:grid;grid-template-columns:auto auto;gap:2px 10px;align-items:end;min-width:170px}.source-stats strong{font-size:2.2rem;color:#ffdc45;text-align:right}.source-stats span{font-weight:850;color:#dbeeff}.library-section{margin-top:46px;padding-top:42px;border-top:1px solid #dce7f3}.section-head{display:flex;gap:18px;justify-content:space-between;align-items:end}.section-head h2{margin:.2rem 0 .45rem}.section-head p{max-width:820px;color:#60718a}.search-row{display:flex;gap:10px;align-items:center;margin:18px 0}.search-row input{width:100%;padding:13px 15px;border:1px solid #d9e3ee;border-radius:14px;font:inherit}.search-row span{white-space:nowrap;font-weight:850;color:#0b4aa2}.quran-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.quran-card{display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:10px;padding:13px;border:1px solid #dce7f3;border-radius:16px;background:#fff}.qnum{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#eef6ff;color:#0b4aa2;font-weight:900}.quran-card strong{display:block;color:#10284f}.quran-card small{display:block;color:#6c7c92;margin-top:4px}.arabic{float:right;font-family:serif;font-size:1.1rem;color:#0d77a5}.local-badge{display:inline-flex;justify-self:end;padding:6px 8px;border-radius:999px;background:#eef9f7;color:#087b71;font-size:.65rem;font-weight:900}.book-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.book-card{display:grid;grid-template-columns:40px 1fr;gap:12px;padding:16px;border:1px solid #dce7f3;border-radius:18px;background:#fff;box-shadow:0 10px 24px rgba(7,31,77,.04)}.book-mark{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#fff4c8;color:#9a7300;font-weight:900}.book-type{font-size:.68rem;font-weight:900;color:#8a6b00;text-transform:uppercase;letter-spacing:.08em}.book-card h3{font-size:.95rem;margin:.25rem 0 .55rem;color:#132d55}.feature-grid,.study-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:42px}.feature-card,.study-card{padding:22px;border-radius:22px;border:1px solid #dce7f3;background:#fff}.feature-card span,.study-card span{font-size:1.8rem;font-weight:900}.feature-card h2,.study-card h2{margin:.5rem 0}.feature-card p,.study-card p{color:#60718a}.feature-card a{font-weight:850;color:#0b4aa2}.feature-card.amber{border-top:5px solid #ffd84a}.feature-card.pink{border-top:5px solid #ff6ea8}.feature-card.teal{border-top:5px solid #11a7a1}.study-card.blue{background:linear-gradient(180deg,#eef7ff,#fff)}.study-card.gold{background:linear-gradient(180deg,#fff9df,#fff)}.study-card.teal{background:linear-gradient(180deg,#effcfb,#fff)}.book-grid [hidden],.quran-grid [hidden]{display:none!important}@media(max-width:820px){.source-hero,.quran-grid,.feature-grid,.study-grid{grid-template-columns:1fr;display:grid}.book-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.section-head{align-items:start;flex-direction:column}}@media(max-width:520px){.book-grid{grid-template-columns:1fr}.quran-card{grid-template-columns:40px 1fr}.local-badge{grid-column:2;justify-self:start}.arabic{float:none;display:block;margin-top:3px}.source-stats{margin-top:8px}}
</style>
