---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import { sitePath } from '../data/site';

const collections = [
  { id:'keluar', icon:'↗', tone:'cyan', title:'Surat Keluar', desc:'Surat yang diterbitkan organisasi, termasuk surat rekomendasi, undangan, pemberitahuan dan surat tugas.' },
  { id:'masuk', icon:'↘', tone:'violet', title:'Surat Masuk', desc:'Register surat masuk, disposisi dan tindak lanjut.' },
  { id:'keputusan', icon:'★', tone:'gold', title:'Surat Keputusan & Surat Tugas', desc:'SK, surat tugas, mandat dan keputusan organisasi.' },
  { id:'notulensi', icon:'✎', tone:'pink', title:'Notulensi', desc:'Catatan rapat, musyawarah, kajian dan tindak lanjut.' },
  { id:'wakaf', icon:'◇', tone:'green', title:'Daftar & Sertifikat Wakaf', desc:'Indeks aset wakaf dan dokumen pendukungnya.' },
  { id:'aktif-organisasi', icon:'✓', tone:'orange', title:'Surat Aktif Organisasi', desc:'Layanan surat keterangan aktif organisasi.' },
  { id:'pedoman', icon:'§', tone:'blue', title:'Pedoman Surat Menyurat', desc:'Tata naskah, penomoran, kop, disposisi dan pengarsipan.' }
];
const localDocuments = [
  { id:'rekomendasi-paryono', title:'Surat Rekomendasi Kuliah Pak Paryono', year:'2020', type:'DOCX', category:'Surat Keluar', preview:sitePath('/arsip/surat-rekomendasi-kuliah-pak-paryono.html'), description:'Dokumen offline dari paket arsip PCM Somagede. Ditampilkan sebagai pratinjau lokal di dalam situs.' }
];
---
<MainLayout title="ArsipMu">
  <PageHero eyebrow="Administrasi & dokumen" title="ArsipMu" description="Pusat dokumen PCM Somagede yang membaca arsip lokal, bukan melempar pembaca ke situs lain." />
  <main class="section archive-page"><div class="container">
    <section class="archive-intro"><div><span class="eyebrow">Dokumen lokal</span><h2>Arsip yang benar-benar bisa dibaca.</h2><p>Dokumen yang tersedia di paket offline dipetakan ke katalog ini. Bila berkas fisik belum tersedia, kartu tidak berpura-pura menjadi dokumen.</p></div><div class="archive-stat"><strong>{localDocuments.length}</strong><span>dokumen siap pratinjau</span></div></section>

    <section id="surat" class="local-docs"><div class="section-head"><div><span class="eyebrow">Pratinjau aktif</span><h2>Dokumen Offline PCM Somagede</h2><p>Tekan Pratinjau untuk membuka isi dokumen di dalam panel yang sama.</p></div></div>
      <div class="doc-grid">{localDocuments.map((doc)=><article class="doc-card"><div class="doc-icon">▤</div><div class="doc-meta"><span>{doc.category}</span><b>{doc.year}</b></div><h3>{doc.title}</h3><p>{doc.description}</p><div class="doc-actions"><button class="button button-primary preview-doc" type="button" data-title={doc.title} data-preview={doc.preview}>Pratinjau</button><a class="button button-secondary" href={doc.preview} target="_self">Buka halaman dokumen</a></div></article>)}</div>
    </section>

    <section class="archive-grid" aria-label="Kelompok ArsipMu">{collections.map((item)=><article id={item.id} class:list={{'archive-card':true,[`tone-${item.tone}`]:true}}><span class="archive-icon">{item.icon}</span><span class="archive-kicker">Koleksi</span><h3>{item.title}</h3><p>{item.desc}</p><span class="empty-badge">Belum ada berkas lokal</span></article>)}</section>

    <section id="arsip-tahunan" class="archive-note"><div><span class="eyebrow">Indeks tahunan</span><h2>2020 → 2026</h2><p>Dokumen lama tetap bisa ditambahkan satu per satu dari panel editor. Tidak ada kartu contoh yang menyamar sebagai arsip resmi.</p></div><a class="button button-secondary" href={sitePath('/admin/media')}>Kelola Media →</a></section>
  </div></main>
</MainLayout>

<div class="preview-modal" id="preview-modal" aria-hidden="true"><div class="preview-backdrop"></div><section class="preview-card" role="dialog" aria-modal="true" aria-labelledby="preview-title"><header><div><span class="eyebrow">Pratinjau lokal</span><h2 id="preview-title">Dokumen</h2></div><button id="preview-close" type="button" aria-label="Tutup">×</button></header><div class="preview-frame-wrap"><iframe id="preview-frame" title="Pratinjau dokumen lokal"></iframe></div></section></div>
<script>
const modal=document.querySelector<HTMLElement>('#preview-modal');const frame=document.querySelector<HTMLIFrameElement>('#preview-frame');const title=document.querySelector<HTMLElement>('#preview-title');const close=()=>{if(!modal)return;modal.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open');if(frame)frame.src='about:blank'};
document.querySelectorAll<HTMLButtonElement>('.preview-doc').forEach((button)=>button.addEventListener('click',()=>{if(!modal||!frame)return;title!.textContent=button.dataset.title||'Dokumen';frame.src=button.dataset.preview||'about:blank';modal.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}));
document.querySelector('#preview-close')?.addEventListener('click',close);document.querySelector('.preview-backdrop')?.addEventListener('click',close);document.addEventListener('keydown',(e)=>{if(e.key==='Escape')close()});
</script>
<style>
.archive-page{padding-top:34px}.archive-intro{display:grid;grid-template-columns:1fr auto;gap:22px;align-items:center;margin-bottom:30px}.archive-intro h2{font-size:clamp(2rem,4vw,3rem);margin:.25rem 0 .5rem}.archive-intro p{max-width:820px;color:#64758c}.archive-stat{min-width:180px;padding:22px;border-radius:22px;text-align:center;color:#fff;background:linear-gradient(135deg,#0b4aa2,#0da6a2);box-shadow:0 18px 40px rgba(11,74,162,.18)}.archive-stat strong{display:block;font-size:2.8rem;line-height:1}.archive-stat span{font-size:.78rem;font-weight:850}.local-docs{padding:30px;border-radius:28px;background:linear-gradient(135deg,#071f4d,#0b5fa9);color:#fff;box-shadow:0 22px 50px rgba(7,31,77,.16)}.section-head h2{margin:.25rem 0 .4rem}.section-head p{margin:0;color:#dcecff}.doc-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;margin-top:20px}.doc-card{position:relative;padding:22px;border-radius:22px;background:#fff;color:#14233b;border:1px solid rgba(255,255,255,.25);box-shadow:0 12px 30px rgba(0,0,0,.12)}.doc-icon{display:grid;place-items:center;width:48px;height:48px;border-radius:15px;background:#eef6ff;color:#0b4aa2;font-weight:950;font-size:1.3rem}.doc-meta{display:flex;justify-content:space-between;margin-top:15px;font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:#6a7a90}.doc-card h3{margin:.45rem 0 .55rem;font-size:1.2rem}.doc-card p{color:#68788d;font-size:.86rem}.doc-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:17px}.doc-actions .button{cursor:pointer}.archive-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:34px}.archive-card{padding:22px;border-radius:22px;background:#fff;border:1px solid #dce7f3;box-shadow:0 12px 28px rgba(7,31,77,.06);border-top:5px solid #0b4aa2}.archive-icon{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:#f1f6fb;color:#0b4aa2;font-size:1.1rem;font-weight:950}.archive-kicker{display:block;margin-top:16px;color:#7a899d;font-size:.66rem;text-transform:uppercase;letter-spacing:.1em;font-weight:900}.archive-card h3{margin:.3rem 0 .45rem}.archive-card p{color:#65768d;font-size:.86rem;min-height:52px}.empty-badge{display:inline-flex;padding:7px 9px;border-radius:999px;background:#f5f7fa;color:#8290a2;font-size:.68rem;font-weight:850}.tone-cyan{border-top-color:#54cfff}.tone-violet{border-top-color:#9b7bff}.tone-gold{border-top-color:#ffd84a}.tone-pink{border-top-color:#ff6ea8}.tone-green{border-top-color:#56d19a}.tone-orange{border-top-color:#ff9b54}.tone-blue{border-top-color:#0b4aa2}.archive-note{margin-top:28px;padding:26px;border-radius:25px;background:linear-gradient(135deg,#fff4c9,#fffdf4);border:1px solid #f0dc8b;display:flex;justify-content:space-between;gap:18px;align-items:center}.archive-note h2{margin:.25rem 0}.archive-note p{color:#665b37}.preview-modal{position:fixed;inset:0;z-index:300;display:none}.preview-modal[aria-hidden="false"]{display:block}.preview-backdrop{position:absolute;inset:0;background:rgba(2,18,43,.72);backdrop-filter:blur(7px)}.preview-card{position:relative;width:min(1080px,calc(100% - 22px));height:min(92vh,900px);margin:4vh auto 0;background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 35px 90px rgba(0,0,0,.3);display:grid;grid-template-rows:auto 1fr}.preview-card header{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:17px 20px;border-bottom:1px solid #dce6f1}.preview-card h2{margin:.2rem 0 0;font-size:1.15rem}.preview-card header button{width:40px;height:40px;border:0;border-radius:50%;background:#edf4fb;color:#173554;font-size:1.45rem;cursor:pointer}.preview-frame-wrap{background:#eaf0f7;padding:12px;min-height:0}.preview-frame-wrap iframe{width:100%;height:100%;border:0;border-radius:14px;background:#f4f7fb}.modal-open{overflow:hidden}@media(max-width:850px){.archive-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.archive-intro{grid-template-columns:1fr}.archive-stat{width:100%}.doc-grid,.archive-grid{grid-template-columns:1fr}.local-docs{padding:20px}.preview-card{height:95vh;margin:2.5vh auto 0;border-radius:18px}}
</style>
