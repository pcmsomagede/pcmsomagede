---
import MainLayout from '../../layouts/MainLayout.astro';
import { sitePath } from '../../data/site';
---
<MainLayout title="Editor Menu"><main><section class="section"><div class="container menu-editor"><a class="back" href={sitePath('/admin')}>← Kembali ke CMS</a><div class="head"><div><span class="eyebrow">Editor Menu</span><h1>Atur menu situs sendiri.</h1><p>Tambah, ubah, susun atau hapus menu yang tidak kamu inginkan. Perubahan disimpan ke konfigurasi situs dan diterbitkan lewat GitHub.</p></div><span id="save-status" class="status">Siap</span></div><div id="menu-list" class="menu-list"></div><div class="bottom-actions"><button id="add-group" class="button secondary" type="button">＋ Tambah Menu Utama</button><button id="save" class="button primary" type="button">Simpan Perubahan</button></div><p id="error" class="error" hidden></p></div></section></main></MainLayout>
<script is:inline>
const API='https://pcmsomagede-cms-api.pcmsomagede.workers.dev';const KEY='pcmsomagede.cms.token';const list=document.querySelector('#menu-list');const status=document.querySelector('#save-status');const error=document.querySelector('#error');let menu=[];
const esc=(s)=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const render=()=>{if(!list)return;list.innerHTML=menu.map((g,gi)=>`<section class="group" data-group="${gi}"><div class="group-head"><span class="drag">☷</span><div class="grow"><input data-g-label value="${esc(g.label)}" aria-label="Nama menu utama"><div class="mini-row"><input data-g-icon value="${esc(g.icon||'•')}" aria-label="Ikon"><input data-g-href value="${esc(g.href)}" aria-label="Alamat menu utama"></div></div><button class="danger remove-group" type="button">Hapus</button></div><div class="children">${(g.items||[]).map((it,ii)=>`<div class="child" data-item="${ii}"><span class="child-dot">↳</span><input data-i-label value="${esc(it.label)}" aria-label="Nama submenu"><input data-i-href value="${esc(it.href)}" aria-label="Alamat submenu"><button class="icon-button remove-item" type="button" aria-label="Hapus submenu">×</button></div>`).join('')}</div><button class="add-item" type="button">＋ Tambah submenu</button></section>`).join('');
list.querySelectorAll('[data-group]').forEach((groupEl)=>{const gi=Number(groupEl.getAttribute('data-group'));groupEl.querySelector('[data-g-label]')?.addEventListener('input',e=>menu[gi].label=e.target.value);groupEl.querySelector('[data-g-icon]')?.addEventListener('input',e=>menu[gi].icon=e.target.value);groupEl.querySelector('[data-g-href]')?.addEventListener('input',e=>menu[gi].href=e.target.value);groupEl.querySelector('.remove-group')?.addEventListener('click',()=>{if(menu.length<=1)return;menu.splice(gi,1);render()});groupEl.querySelector('.add-item')?.addEventListener('click',()=>{menu[gi].items=[...(menu[gi].items||[]),{label:'Menu baru',href:'/'}];render()});groupEl.querySelectorAll('[data-item]').forEach((itemEl)=>{const ii=Number(itemEl.getAttribute('data-item'));itemEl.querySelector('[data-i-label]')?.addEventListener('input',e=>menu[gi].items[ii].label=e.target.value);itemEl.querySelector('[data-i-href]')?.addEventListener('input',e=>menu[gi].items[ii].href=e.target.value);itemEl.querySelector('.remove-item')?.addEventListener('click',()=>{menu[gi].items.splice(ii,1);render()})})})};
const auth=()=>sessionStorage.getItem(KEY)||'';const load=async()=>{try{const r=await fetch(`${API}/api/menu`,{cache:'no-store'});const d=await r.json();if(!r.ok)throw new Error(d.error||'Menu tidak dapat dibaca.');menu=d.menu||[];render()}catch(e){error.textContent=e.message;error.hidden=false}};
document.querySelector('#add-group')?.addEventListener('click',()=>{menu.push({label:'Menu baru',icon:'•',href:'/',items:[]});render()});document.querySelector('#save')?.addEventListener('click',async()=>{error.hidden=true;const token=auth();if(!token){error.textContent='Sesi admin tidak ditemukan. Kembali ke /admin dan login lagi.';error.hidden=false;return}status.textContent='Menyimpan…';try{const r=await fetch(`${API}/api/menu`,{method:'PUT',headers:{'content-type':'application/json',Authorization:`Bearer ${token}`},body:JSON.stringify(menu)});const d=await r.json();if(!r.ok)throw new Error(d.error||'Gagal menyimpan menu.');menu=d.menu||menu;status.textContent='✓ Tersimpan';}catch(e){status.textContent='Gagal';error.textContent=e.message;error.hidden=false}});load();
</script>
<style>
.menu-editor{max-width:1000px}.back{display:inline-block;margin-bottom:18px;color:#0b4aa2;font-weight:850}.head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.head h1{font-size:clamp(2rem,4vw,3.1rem);margin:.25rem 0 .5rem}.head p{max-width:760px;color:#65768d}.status{padding:8px 12px;border-radius:999px;background:#eef6ff;color:#0b4aa2;font-weight:900;white-space:nowrap}.menu-list{display:grid;gap:14px}.group{padding:18px;border-radius:22px;background:#fff;border:1px solid #dce7f3;box-shadow:0 10px 25px rgba(7,31,77,.06)}.group-head{display:flex;gap:12px;align-items:start}.drag{font-size:1.3rem;color:#8a99ab;padding-top:9px}.grow{flex:1}.grow>input{font-size:1.05rem;font-weight:900}.mini-row{display:grid;grid-template-columns:80px 1fr;gap:8px;margin-top:8px}.group input,.child input{width:100%;box-sizing:border-box;border:1px solid #d3deea;border-radius:10px;padding:9px 10px;font:inherit;color:#173451;background:#fbfdff}.children{display:grid;gap:7px;margin:12px 0 8px 34px}.child{display:grid;grid-template-columns:28px 1fr 1.2fr 36px;gap:7px;align-items:center}.child-dot{color:#0b7d8a;font-weight:900;text-align:center}.icon-button,.danger{border:0;cursor:pointer;font:inherit;font-weight:850}.icon-button{width:36px;height:36px;border-radius:10px;background:#fff0f1;color:#a23b45;font-size:1.15rem}.danger{padding:9px 11px;border-radius:10px;background:#fff0f1;color:#a23b45}.add-item{margin-left:34px;border:0;background:#eef7ff;color:#0b4aa2;border-radius:10px;padding:9px 11px;font-weight:850;cursor:pointer}.bottom-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.button{border:0;border-radius:11px;padding:11px 16px;font:inherit;font-weight:900;cursor:pointer}.primary{background:#0b4aa2;color:#fff}.secondary{background:#eef3f8;color:#203a59}.error{margin-top:15px;padding:12px;border-radius:11px;background:#fff0f1;color:#9d3742}@media(max-width:650px){.head{align-items:start;flex-direction:column}.mini-row{grid-template-columns:60px 1fr}.children{margin-left:0}.child{grid-template-columns:22px 1fr 36px}.child input:nth-child(3){grid-column:2 / 4}.group-head{align-items:start}.danger{padding:8px}.add-item{margin-left:0}}
</style>
