---
import MainLayout from '../layouts/MainLayout.astro';
import { quranSurahs } from '../data/quran';

const books = [
  'Kode Indeks Surat Muhammadiyah',
  'Tanya Jawab Agama Jilid 1',
  'Tanya Jawab Agama Jilid 2',
  'Tanya Jawab Agama Jilid 3',
  'Tanya Jawab Agama Jilid 5',
  'Tanya Jawab Agama Jilid 6',
  'Tanya Jawab Agama Jilid 7',
  'Tanya Jawab Agama Jilid 8',
  'Buku Tuntunan Tabligh',
  'Dua Menyemai Damai',
  'Pedoman Keprotokolan Muhammadiyah',
  'Himpunan Peraturan Organisasi Muhammadiyah 2022',
  'Muhammadiyah Ahmad Dahlan Menemukan Kembali Otentitas Gerakan',
  'Muhammadiyah dalam Perspektif Sejarah, Organisasi dan Sistem Nilai',
  'Muhammadiyah Jawa - Ahmad Najib Burhani',
  'Pedoman Tata Naskah Dinas Muhammadiyah',
  'Percik Pemikiran Tokoh Muhammadiyah untuk Indonesia Berkemajuan',
  'Tafsir Al Ma’un Abad II Muhammadiyah',
  'Pedoman Masjid Muhammadiyah',
  'Fikih Salat Berjamaah',
  'Himpunan Putusan Tarjih Buku 1',
  'AD/ART Muhammadiyah Tahun 2020',
  'Pedoman Hidup Islami Warga Muhammadiyah',
  'Tuntunan Perawatan Jenazah',
  'Pedoman Pelaksanaan Perkaderan Muhammadiyah',
  'Modul Baitul Arqam',
  'Sistem Perkaderan Muhammadiyah',
  'Panduan Dakwah Digital Muhammadiyah Era AI',
  'Kosmologi Nuzulul Qur’an',
  'Hikmah Ramadan',
  'Fakta Sejarah dan Mitos Walisongo'
];
---

<MainLayout title="PustakaMu">
  <main class="library-page">
    <section class="library-hero">
      <div class="hero-copy">
        <div class="eyebrow">PUSTAKAMU · PERPUSTAKAAN DIGITAL</div>
        <h1>PustakaMu</h1>
        <p>Ruang baca digital PCM Somagede untuk Al-Qur’an, buku, referensi, khutbah, kultum, dan materi belajar.</p>
        <div class="hero-stats">
          <span><strong>114</strong> surah</span>
          <span><strong>{books.length}</strong> referensi</span>
          <span><strong>Offline</strong> siap dibaca</span>
        </div>
      </div>
      <div class="hero-quran" aria-hidden="true">
        <div class="ornament">۞</div>
        <div class="hero-arabic">القرآن الكريم</div>
        <div class="hero-caption">Baca · Simpan · Lanjutkan</div>
      </div>
    </section>

    <section class="continue-card" id="continue-card" hidden>
      <div class="continue-icon">↗</div>
      <div>
        <span class="mini-label">LANJUTKAN BACAAN</span>
        <strong id="continue-title">Surah terakhir</strong>
        <small id="continue-meta"></small>
      </div>
      <button id="continue-button" type="button">Buka</button>
    </section>

    <nav class="library-tabs" aria-label="Kategori pustaka">
      <button class="tab active" data-tab="quran">Al-Qur’anMu</button>
      <button class="tab" data-tab="books">Buku & Referensi</button>
      <button class="tab" data-tab="khutbah">Khutbah & Kultum</button>
      <button class="tab" data-tab="study">Ruang Belajar</button>
    </nav>

    <section class="tab-panel active" id="panel-quran">
      <div class="section-heading">
        <div>
          <span class="eyebrow dark">AL-QUR’ANMU</span>
          <h2>Al-Qur’an Arab & Terjemah Indonesia</h2>
          <p>Pilih surah untuk mulai membaca. Favorit dan bacaan terakhir tersimpan di perangkat.</p>
        </div>
        <div class="quran-count" id="quran-count">114 surah</div>
      </div>

      <div class="toolbar">
        <label class="search-box"><span>⌕</span><input id="quran-search" type="search" placeholder="Cari surah atau arti…" autocomplete="off" /></label>
        <div class="filters">
          <button class="filter active" data-filter="all">Semua 114</button>
          <button class="filter" data-filter="juzamma">Juz Amma</button>
          <button class="filter" data-filter="favorites">Favorit <span id="favorite-count">0</span></button>
        </div>
      </div>

      <div class="surah-grid" id="surah-grid">
        {quranSurahs.map((s) => (
          <article class="surah-card" data-no={s.no} data-search={`${s.no} ${s.name} ${s.meaning} ${s.arabic}`}>
            <button class="favorite" data-favorite={s.no} type="button" aria-label={`Favorit ${s.name}`} aria-pressed="false">♡</button>
            <button class="surah-open" data-surah={s.no} type="button">
              <span class="surah-number">{String(s.no).padStart(2, '0')}</span>
              <span class="surah-info"><strong>{s.name}</strong><small>{s.meaning} · {s.verses} ayat</small></span>
              <span class="surah-arabic">{s.arabic}</span>
            </button>
          </article>
        ))}
      </div>
      <div class="empty-state" id="quran-empty" hidden>Tidak ada surah yang cocok.</div>
    </section>

    <section class="tab-panel" id="panel-books">
      <div class="section-heading">
        <div><span class="eyebrow dark">BUKUMU</span><h2>Buku & Referensi</h2><p>Koleksi bacaan untuk belajar, organisasi, dakwah, fikih, dan sejarah.</p></div>
        <div class="quran-count">{books.length} koleksi</div>
      </div>
      <label class="search-box wide"><span>⌕</span><input id="book-search" type="search" placeholder="Cari judul buku…" autocomplete="off" /></label>
      <div class="book-grid" id="book-grid">
        {books.map((title, i) => (
          <article class="book-card" data-search={title}>
            <span class="book-index">{String(i + 1).padStart(2, '0')}</span>
            <div><span class="book-label">BUKU / REFERENSI</span><h3>{title}</h3><button class="book-action" type="button">Buka koleksi →</button></div>
          </article>
        ))}
      </div>
      <div class="empty-state" id="book-empty" hidden>Tidak ada buku yang cocok.</div>
    </section>

    <section class="tab-panel" id="panel-khutbah">
      <div class="section-heading"><div><span class="eyebrow dark">MATERI DAKWAH</span><h2>Khutbah & Kultum</h2><p>Ruang khusus untuk materi singkat yang mudah ditemukan dan dibaca.</p></div></div>
      <div class="feature-grid">
        <article class="feature-card feature-amber"><span class="feature-icon">✦</span><h3>Khutbah Jumat</h3><p>Naskah khutbah, tema, dan bahan persiapan penyampaian.</p><button type="button">Lihat materi →</button></article>
        <article class="feature-card feature-teal"><span class="feature-icon">☼</span><h3>Kultum</h3><p>Materi kultum ringkas untuk Ramadan, pengajian, dan kegiatan jamaah.</p><button type="button">Lihat materi →</button></article>
        <article class="feature-card feature-violet"><span class="feature-icon">د</span><h3>Dakwah Digital</h3><p>Kumpulan bahan yang siap dibaca, dipelajari, dan dikembangkan.</p><button type="button">Lihat materi →</button></article>
      </div>
    </section>

    <section class="tab-panel" id="panel-study">
      <div class="section-heading"><div><span class="eyebrow dark">RUANG BELAJAR</span><h2>Belajar Bertahap</h2><p>Mulai dari dasar dan lanjutkan sesuai kebutuhan.</p></div></div>
      <div class="study-grid">
        <article class="study-card"><span>ا ب ت</span><h3>Arab Dasar → Mahir</h3><p>Huruf, kosakata, membaca, percakapan, nahwu, sharaf, dan pemahaman.</p></article>
        <article class="study-card"><span>كتاب</span><h3>Kitab Kuning</h3><p>Membaca matan, tarkib, nahwu-sharaf, syarah, dan diskusi bertahap.</p></article>
        <article class="study-card"><span>حديث</span><h3>HaditsMu</h3><p>Ruang belajar hadits dengan alur baca yang sederhana dan terarah.</p></article>
      </div>
    </section>

    <div class="reader" id="reader" hidden>
      <div class="reader-backdrop" data-close-reader></div>
      <article class="reader-sheet">
        <button class="reader-close" type="button" data-close-reader aria-label="Tutup">×</button>
        <span class="eyebrow dark">AL-QUR’ANMU</span>
        <div class="reader-heading"><div><span id="reader-number"></span><h2 id="reader-name"></h2><p id="reader-meaning"></p></div><button id="reader-favorite" class="reader-heart" type="button">♡</button></div>
        <div class="reader-divider"></div>
        <p class="reader-note">Teks Arab dan terjemah Indonesia ditampilkan dari koleksi lokal yang tersedia di aplikasi.</p>
        <div class="reader-placeholder">رَبِّ زِدْنِي عِلْمًا<br /><small>Mulai membaca dari koleksi Al-Qur’anMu.</small></div>
      </article>
    </div>
  </main>
</MainLayout>

<script>
const quran = [...document.querySelectorAll('.surah-card')];
const favorites = new Set(JSON.parse(localStorage.getItem('pustakamu:favorites') || '[]').map(Number));
const lastRead = Number(localStorage.getItem('pustakamu:lastRead') || 0);
const favCount = document.querySelector('#favorite-count');
const continueCard = document.querySelector('#continue-card');

function syncFavorites() {
  document.querySelectorAll('[data-favorite]').forEach((button) => {
    const no = Number(button.dataset.favorite);
    const active = favorites.has(no);
    button.textContent = active ? '♥' : '♡';
    button.classList.toggle('is-favorite', active);
    button.setAttribute('aria-pressed', String(active));
  });
  favCount.textContent = favorites.size;
  localStorage.setItem('pustakamu:favorites', JSON.stringify([...favorites]));
}

function showContinue() {
  if (!lastRead) return;
  const item = quran.find((card) => Number(card.dataset.no) === lastRead);
  if (!item) return;
  const title = item.querySelector('strong')?.textContent || 'Surah terakhir';
  const meta = item.querySelector('small')?.textContent || '';
  document.querySelector('#continue-title').textContent = title;
  document.querySelector('#continue-meta').textContent = meta;
  continueCard.hidden = false;
  document.querySelector('#continue-button').onclick = () => openReader(lastRead);
}

function openReader(no) {
  const card = quran.find((item) => Number(item.dataset.no) === Number(no));
  if (!card) return;
  const title = card.querySelector('strong')?.textContent || '';
  const meta = card.querySelector('small')?.textContent || '';
  document.querySelector('#reader-number').textContent = String(no).padStart(2, '0');
  document.querySelector('#reader-name').textContent = title;
  document.querySelector('#reader-meaning').textContent = meta;
  document.querySelector('#reader-favorite').textContent = favorites.has(Number(no)) ? '♥' : '♡';
  document.querySelector('#reader-favorite').classList.toggle('is-favorite', favorites.has(Number(no)));
  document.querySelector('#reader-favorite').onclick = () => {
    const n = Number(no);
    favorites.has(n) ? favorites.delete(n) : favorites.add(n);
    syncFavorites();
    document.querySelector('#reader-favorite').textContent = favorites.has(n) ? '♥' : '♡';
  };
  localStorage.setItem('pustakamu:lastRead', String(no));
  document.querySelector('#reader').hidden = false;
  document.body.classList.add('reader-open');
}

document.querySelectorAll('[data-favorite]').forEach((button) => button.addEventListener('click', (event) => {
  event.stopPropagation();
  const no = Number(button.dataset.favorite);
  favorites.has(no) ? favorites.delete(no) : favorites.add(no);
  syncFavorites();
}));

document.querySelectorAll('[data-surah]').forEach((button) => button.addEventListener('click', () => openReader(Number(button.dataset.surah))));

document.querySelectorAll('[data-close-reader]').forEach((item) => item.addEventListener('click', () => {
  document.querySelector('#reader').hidden = true;
  document.body.classList.remove('reader-open');
}));

document.querySelectorAll('.tab').forEach((tab) => tab.addEventListener('click', () => {
  document.querySelectorAll('.tab').forEach((item) => item.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach((panel) => panel.classList.remove('active'));
  tab.classList.add('active');
  document.querySelector(`#panel-${tab.dataset.tab}`).classList.add('active');
}));

let activeFilter = 'all';
function filterQuran() {
  const query = document.querySelector('#quran-search').value.toLowerCase().trim();
  let shown = 0;
  quran.forEach((card) => {
    const no = Number(card.dataset.no);
    const searchMatch = !query || card.dataset.search.toLowerCase().includes(query);
    const juzMatch = activeFilter !== 'juzamma' || no >= 78;
    const favoriteMatch = activeFilter !== 'favorites' || favorites.has(no);
    const visible = searchMatch && juzMatch && favoriteMatch;
    card.hidden = !visible;
    if (visible) shown++;
  });
  document.querySelector('#quran-count').textContent = `${shown} surah`;
  document.querySelector('#quran-empty').hidden = shown !== 0;
}

document.querySelector('#quran-search').addEventListener('input', filterQuran);
document.querySelectorAll('.filter').forEach((button) => button.addEventListener('click', () => {
  document.querySelectorAll('.filter').forEach((item) => item.classList.remove('active'));
  button.classList.add('active');
  activeFilter = button.dataset.filter;
  filterQuran();
}));

const booksEls = [...document.querySelectorAll('.book-card')];
document.querySelector('#book-search').addEventListener('input', (event) => {
  const query = event.target.value.toLowerCase().trim();
  let shown = 0;
  booksEls.forEach((card) => {
    const visible = !query || card.dataset.search.toLowerCase().includes(query);
    card.hidden = !visible;
    if (visible) shown++;
  });
  document.querySelector('#book-empty').hidden = shown !== 0;
});

syncFavorites();
showContinue();
</script>

<style>
:root{--ink:#10233f;--muted:#6d7c91;--line:#e1e8f0;--paper:#f7f9fc;--blue:#0b4f91;--teal:#0d9f98;--gold:#f4c84a;--violet:#6b57d8}
.library-page{min-height:100vh;background:var(--paper);padding:28px 0 80px}.library-page>*{max-width:1180px;margin-left:auto;margin-right:auto}.library-hero{display:grid;grid-template-columns:1.5fr .8fr;gap:28px;align-items:stretch;padding:46px;border-radius:30px;background:linear-gradient(135deg,#082a57 0%,#0a5b9f 55%,#11a19b 100%);color:#fff;box-shadow:0 24px 60px rgba(8,42,87,.16)}.eyebrow{display:inline-block;font-size:.72rem;font-weight:900;letter-spacing:.12em;color:#f7d24d}.hero-copy h1{font-size:clamp(3rem,7vw,5.7rem);line-height:.94;margin:12px 0 18px;letter-spacing:-.055em}.hero-copy p{max-width:720px;margin:0;color:#e7f2ff;font-size:1.05rem;line-height:1.75}.hero-stats{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.hero-stats span{padding:9px 13px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.08);border-radius:999px;font-size:.82rem}.hero-stats strong{color:#fff}.hero-quran{display:grid;place-items:center;align-content:center;text-align:center;border-radius:24px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.18);min-height:240px}.ornament{font-size:3.2rem;color:#f7d24d}.hero-arabic{font-family:serif;font-size:2rem;margin:8px 0}.hero-caption{font-size:.75rem;color:#d7ebff;letter-spacing:.12em;text-transform:uppercase}.continue-card{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;margin-top:18px;padding:16px 18px;border:1px solid #d7e4ee;border-radius:18px;background:#fff;box-shadow:0 8px 24px rgba(16,35,63,.05)}.continue-icon{display:grid;place-items:center;width:42px;height:42px;border-radius:13px;background:#eaf7f6;color:var(--teal);font-weight:900}.continue-card strong{display:block;color:var(--ink)}.continue-card small{color:var(--muted)}.mini-label,.book-label{font-size:.64rem;font-weight:900;letter-spacing:.1em;color:#8190a3}.continue-card button,.book-action,.feature-card button{border:0;border-radius:12px;padding:10px 14px;background:#0c5f9e;color:#fff;font-weight:800;cursor:pointer}.library-tabs{display:flex;gap:8px;overflow:auto;padding:24px 0 8px;scrollbar-width:none}.library-tabs::-webkit-scrollbar{display:none}.tab,.filter{white-space:nowrap;border:1px solid #d8e3ee;background:#fff;color:#1b385b;border-radius:999px;padding:10px 15px;font-weight:800;cursor:pointer}.tab.active{background:#0c6b9c;color:#fff;border-color:#0c6b9c}.tab-panel{display:none;padding-top:28px}.tab-panel.active{display:block}.section-heading{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:22px}.eyebrow.dark{color:#0d7590}.section-heading h2{margin:7px 0 7px;color:var(--ink);font-size:clamp(1.7rem,3vw,2.45rem);letter-spacing:-.03em}.section-heading p{margin:0;color:var(--muted);line-height:1.65}.quran-count{white-space:nowrap;color:#0b6492;font-weight:900}.toolbar{display:flex;gap:12px;align-items:center;margin-bottom:18px}.search-box{display:flex;align-items:center;gap:10px;flex:1;background:#fff;border:1px solid #d7e2ed;border-radius:15px;padding:0 14px;height:50px}.search-box span{font-size:1.35rem;color:#8493a7}.search-box input{border:0;outline:0;width:100%;background:transparent;font:inherit;color:var(--ink)}.filters{display:flex;gap:7px}.filter{padding:9px 12px;font-size:.8rem}.filter.active{background:#eef6fb;border-color:#acd0e4;color:#075d89}.filter span{opacity:.65}.surah-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.surah-card{position:relative;border:1px solid var(--line);background:#fff;border-radius:17px;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}.surah-card:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(16,35,63,.08);border-color:#c5d8e8}.surah-open{display:grid;grid-template-columns:44px 1fr auto;gap:12px;align-items:center;width:100%;padding:14px 48px 14px 14px;border:0;background:transparent;text-align:left;cursor:pointer;color:inherit}.surah-number{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#eff6fb;color:#0b6293;font-size:.8rem;font-weight:900}.surah-info strong{display:block;color:var(--ink);font-size:.96rem}.surah-info small{display:block;color:var(--muted);font-size:.75rem;margin-top:4px}.surah-arabic{font-family:serif;font-size:1.2rem;color:#28728a}.favorite{position:absolute;right:10px;top:9px;z-index:2;border:0;background:transparent;color:#a6b2c1;font-size:1.25rem;cursor:pointer}.favorite.is-favorite,.reader-heart.is-favorite{color:#d55c78}.empty-state{text-align:center;padding:36px;color:var(--muted);background:#fff;border:1px dashed #d7e0e9;border-radius:17px}.wide{max-width:100%}.book-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.book-card{display:grid;grid-template-columns:38px 1fr;gap:12px;padding:17px;border:1px solid var(--line);border-radius:18px;background:#fff}.book-index{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:#f7f1d9;color:#9a7a18;font-weight:900;font-size:.75rem}.book-card h3{font-size:.93rem;line-height:1.45;color:var(--ink);margin:5px 0 12px}.book-action{background:transparent;color:#0b6492;padding:0}.feature-grid,.study-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.feature-card,.study-card{min-height:210px;padding:24px;border-radius:22px;border:1px solid var(--line);background:#fff}.feature-card{border-top:4px solid #f4c84a}.feature-teal{border-top-color:#0d9f98}.feature-violet{border-top-color:#6b57d8}.feature-icon{font-size:1.8rem;color:#0d7590}.feature-card h3,.study-card h3{font-size:1.25rem;color:var(--ink);margin:15px 0 8px}.feature-card p,.study-card p{color:var(--muted);line-height:1.65}.feature-card button{margin-top:10px;background:#f1f6fa;color:#0b5f8d}.study-card{background:linear-gradient(145deg,#fff,#f4f9fc)}.study-card>span{font-family:serif;font-size:1.8rem;color:#0d7590}.reader{position:fixed;inset:0;z-index:50;display:grid;place-items:end center}.reader[hidden]{display:none}.reader-backdrop{position:absolute;inset:0;background:rgba(6,20,38,.55);backdrop-filter:blur(4px)}.reader-sheet{position:relative;width:min(760px,calc(100% - 24px));max-height:90vh;overflow:auto;margin-bottom:12px;border-radius:26px;background:#fff;padding:30px;box-shadow:0 30px 80px rgba(0,0,0,.22)}.reader-close{position:absolute;right:16px;top:14px;width:38px;height:38px;border:0;border-radius:12px;background:#f1f5f8;color:#536274;font-size:1.5rem;cursor:pointer}.reader-heading{display:flex;justify-content:space-between;align-items:center;margin-top:12px}.reader-heading h2{margin:2px 0;color:var(--ink);font-size:2rem}.reader-heading p{margin:0;color:var(--muted)}.reader-number{font-weight:900;color:#0b7591}.reader-heart{border:0;background:#f8f3f5;color:#a6b2c1;border-radius:14px;width:46px;height:46px;font-size:1.4rem;cursor:pointer}.reader-divider{height:1px;background:var(--line);margin:24px 0}.reader-note{color:var(--muted);font-size:.85rem}.reader-placeholder{margin-top:20px;padding:42px 20px;border-radius:20px;background:#f7fafc;text-align:center;font-family:serif;font-size:2.2rem;line-height:1.8;color:#1d405f}.reader-placeholder small{font-family:inherit;font-size:.8rem;color:var(--muted)}body.reader-open{overflow:hidden}.book-card[hidden],.surah-card[hidden]{display:none!important}@media(max-width:900px){.library-hero{grid-template-columns:1fr}.hero-quran{min-height:180px}.book-grid,.feature-grid,.study-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.toolbar{align-items:stretch;flex-direction:column}.filters{overflow:auto}.section-heading{align-items:start;flex-direction:column}}@media(max-width:620px){.library-page{padding:14px 0 50px}.library-hero{padding:28px 22px;border-radius:22px}.hero-copy h1{font-size:3.5rem}.hero-quran{display:none}.surah-grid,.book-grid,.feature-grid,.study-grid{grid-template-columns:1fr}.surah-open{grid-template-columns:40px 1fr auto}.surah-arabic{font-size:1rem}.reader-sheet{padding:24px 18px}.continue-card{grid-template-columns:auto 1fr}.continue-card button{grid-column:2;justify-self:start}}
</style>
