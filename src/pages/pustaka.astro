---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import { quranSurahs } from '../data/quran';

const PUSTAKA_REF = 'https://www.pcmcepu.com/p/pustaka-digital-download-naskah-khutbah.html';
const QURAN_REF = 'https://www.pcmcepu.com/p/quranmu-muhammadiyah.html';
const books = [
  'Kode Indeks Surat Muhammadiyah','Tanya Jawab Agama Jilid 1','Tanya Jawab Agama Jilid 2','Tanya Jawab Agama Jilid 3','Tanya Jawab Agama Jilid 5','Tanya Jawab Agama Jilid 6','Tanya Jawab Agama Jilid 7','Tanya Jawab Agama Jilid 8','Buku Tuntunan Tabligh','Dua Menyemai Damai','Pedoman Keprotokolan Muhammadiyah','Himpunan Peraturan Organisasi Muhammadiyah 2022','Muhammadiyah Ahmad Dahlan Menemukan Kembali Otentitas Gerakan','Muhammadiyah dalam Perspektif Sejarah, Organisasi dan Sistem Nilai','Muhammadiyah Jawa - Ahmad Najib Burhani','Pedoman Tata Naskah Dinas Muhammadiyah','Percik Pemikiran Tokoh Muhammadiyah untuk Indonesia Berkemajuan','Tafsir Al Ma’un Abad II Muhammadiyah','Pedoman Masjid Muhammadiyah','Fikih Salat Berjamaah','Himpunan Putusan Tarjih Buku 1','AD/ART Muhammadiyah Tahun 2020','Pedoman Hidup Islami Warga Muhammadiyah','Tuntunan Perawatan Jenazah','Pedoman Pelaksanaan Perkaderan Muhammadiyah','Modul Baitul Arqam','Sistem Perkaderan Muhammadiyah','Panduan Dakwah Digital Muhammadiyah Era AI','Kosmologi Nuzulul Qur’an','Hikmah Ramadan','Fakta Sejarah dan Mitos Walisongo'
];
---

<MainLayout title="PustakaMu">
  <PageHero eyebrow="Belajar · Baca · Akses" title="PustakaMu" description="Pusat belajar PCM Somagede dengan jalur langsung ke QuranMu dan Pustaka Digital rujukan." />
  <main class="section"><div class="container">
    <section class="source-hero">
      <div><span class="eyebrow">Rujukan aktif</span><h2>PustakaMu bukan pajangan.</h2><p>Setiap tombol di halaman ini punya tujuan nyata. Al Qur’anMu langsung menuju QuranMu PCM Cepu; BukuMu, khutbah dan kultum langsung menuju Pustaka Digital PCM Cepu. Semua link membuka di tab yang sama.</p></div>
      <div class="source-actions"><a class="source-main" href={QURAN_REF}>Buka Al Qur’anMu ↗</a><a class="source-main light" href={PUSTAKA_REF}>Buka Pustaka Digital ↗</a></div>
    </section>

    <section id="quranmu" class="library-section">
      <div class="section-head"><div><span class="eyebrow">Al Qur’anMu</span><h2>114 Surah — langsung ke sumber</h2><p>Daftar lokal membantu pencarian cepat, sedangkan tombol Buka selalu menuju sumber QuranMu yang dirujuk.</p></div><a class="button button-primary" href={QURAN_REF}>Masuk QuranMu ↗</a></div>
      <div class="search-row"><input id="quran-search" type="search" placeholder="Cari nama surah, arti, atau nomor…"/><span id="quran-count">114 surah</span></div>
      <div class="quran-grid" id="quran-grid">{quranSurahs.map((s) => <article class="quran-card" data-search={`${s.no} ${s.name} ${s.meaning} ${s.arabic}`}><div class="qnum">{s.no}</div><div><strong>{s.name}</strong><span class="arabic">{s.arabic}</span><small>{s.meaning} · {s.verses} ayat</small></div><a href={QURAN_REF}>Buka ↗</a></article>)}</div>
    </section>

    <section id="bukumu" class="library-section book-section">
      <div class="section-head"><div><span class="eyebrow">BukuMu</span><h2>Koleksi Buku &amp; Naskah</h2><p>Judul-judul di bawah dirangkum dari pola katalog Pustaka Digital rujukan. Tombol akses tidak lagi menuju anchor palsu; semuanya langsung menuju katalog sumber.</p></div><a class="button button-primary" href={PUSTAKA_REF}>Buka seluruh katalog ↗</a></div>
      <div class="search-row"><input id="book-search" type="search" placeholder="Cari judul buku…"/><span id="book-count">{books.length} koleksi</span></div>
      <div class="book-grid" id="book-grid">{books.map((title) => <article class="book-card" data-search={title}><span class="book-mark">▤</span><div><span class="book-type">Buku / Naskah</span><h3>{title}</h3><a href={PUSTAKA_REF}>Lihat PDF / sumber ↗</a></div></article>)}</div>
    </section>

    <section id="khutbah" class="feature-grid">
      <article class="feature-card amber"><span>✦</span><h2>Khutbah Jumat</h2><p>Naskah dan tema khutbah langsung tersedia pada Pustaka Digital rujukan.</p><a href={PUSTAKA_REF}>Buka materi khutbah ↗</a></article>
      <article class="feature-card pink"><span>☼</span><h2>Kultum</h2><p>Koleksi kultum dan materi tematik diarahkan langsung ke sumber rujukan.</p><a href={PUSTAKA_REF}>Buka materi kultum ↗</a></article>
      <article class="feature-card teal"><span>كتاب</span><h2>Kitab Kuning</h2><p>Jalur belajar bertingkat dari pengenalan matan, membaca teks Arab, nahwu, sharaf, sampai kajian lanjut.</p><a href="#kitab">Lihat roadmap →</a></article>
    </section>

    <section id="arab" class="study-grid">
      <article class="study-card blue"><span>ا ب ت</span><h2>Arab Dasar → Mahir</h2><p>Mulai dari huruf dan kosakata, lanjut percakapan, membaca, nahwu, sharaf dan latihan pemahaman.</p></article>
      <article id="kitab" class="study-card gold"><span>كتاب</span><h2>Kitab Kuning Dasar → Mahir</h2><p>Tahap 1 membaca huruf dan harakat; tahap 2 kosakata dan tarkib; tahap 3 nahwu-sharaf; tahap 4 membaca matan; tahap 5 syarah dan diskusi.</p></article>
      <article id="haditsmu" class="study-card teal"><span>حديث</span><h2>HaditsMu</h2><p>Ruang belajar dan rujukan hadits. Untuk sumber eksternal yang tersedia saat ini, akses utama diarahkan ke pustaka rujukan.</p><a href={PUSTAKA_REF}>Buka rujukan HaditsMu ↗</a></article>
    </section>

    <div class="access-note"><strong>Catatan penting:</strong> tombol eksternal pada halaman ini sengaja menggunakan navigasi tab yang sama. Kami tidak membuat tombol PDF/DOCX palsu yang hanya terlihat bekerja. Berkas yang belum dimiliki PCM Somagede tidak kami klaim sebagai arsip resmi Somagede.</div>
  </div></main>
</MainLayout>

<script>
const bind=(inputId, selector, countId, unit)=>{const i=document.querySelector(inputId),cards=[...document.querySelectorAll(selector)],c=document.querySelector(countId);const run=()=>{const q=(i?.value||'').toLowerCase().trim();let n=0;cards.forEach(x=>{const ok=!q||(x.getAttribute('data-search')||'').toLowerCase().includes(q);x.hidden=!ok;if(ok)n++});if(c)c.textContent=`${n} ${unit}`};i?.addEventListener('input',run)};
bind('#quran-search','#quran-grid .quran-card','#quran-count','surah');
bind('#book-search','#book-grid .book-card','#book-count','koleksi');
</script>
<style>
.source-hero{display:grid;grid-template-columns:1fr auto;gap:22px;align-items:center;padding:34px;border-radius:28px;background:linear-gradient(135deg,#071f4d,#0b4aa2,#0ea7a3);color:#fff;box-shadow:0 22px 55px rgba(7,31,77,.16)}.source-hero h2{margin:.35rem 0 .5rem;font-size:clamp(2rem,4vw,3.1rem)}.source-hero p{max-width:760px;color:#e7f2ff}.source-actions{display:grid;gap:10px;min-width:230px}.source-main{display:block;text-align:center;padding:13px 15px;border-radius:14px;background:#ffd84a;color:#10234a;font-weight:900}.source-main.light{background:#fff;color:#0b4aa2}.library-section{margin-top:46px;padding-top:42px;border-top:1px solid #dce7f3}.section-head{display:flex;gap:18px;justify-content:space-between;align-items:end}.section-head h2{margin:.2rem 0 .45rem}.section-head p{max-width:820px;color:#60718a}.search-row{display:flex;gap:10px;align-items:center;margin:18px 0}.search-row input{width:100%;padding:13px 15px;border:1px solid #d9e3ee;border-radius:14px;font:inherit}.search-row span{white-space:nowrap;font-weight:850;color:#0b4aa2}.quran-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.quran-card{display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:10px;padding:13px;border:1px solid #dce7f3;border-radius:16px;background:#fff}.qnum{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#eef6ff;color:#0b4aa2;font-weight:900}.quran-card strong{display:block;color:#10284f}.quran-card small{display:block;color:#6c7c92;margin-top:4px}.arabic{float:right;font-family:serif;font-size:1.1rem;color:#0d77a5}.quran-card a,.book-card a,.feature-card a,.study-card a{font-weight:850;color:#0b4aa2;white-space:nowrap}.book-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.book-card{display:grid;grid-template-columns:40px 1fr;gap:12px;padding:16px;border:1px solid #dce7f3;border-radius:18px;background:#fff;box-shadow:0 10px 24px rgba(7,31,77,.04)}.book-mark{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#fff4c8;color:#9a7300;font-weight:900}.book-type{font-size:.68rem;font-weight:900;color:#8a6b00;text-transform:uppercase;letter-spacing:.08em}.book-card h3{font-size:.95rem;margin:.25rem 0 .5rem;color:#132d55}.feature-grid,.study-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:42px}.feature-card,.study-card{padding:22px;border-radius:22px;border:1px solid #dce7f3;background:#fff}.feature-card span,.study-card span{font-size:1.8rem;font-weight:900}.feature-card h2,.study-card h2{margin:.5rem 0}.feature-card p,.study-card p{color:#60718a}.feature-card.amber{border-top:5px solid #ffd84a}.feature-card.pink{border-top:5px solid #ff6ea8}.feature-card.teal{border-top:5px solid #11a7a1}.study-card.blue{background:linear-gradient(180deg,#eef7ff,#fff)}.study-card.gold{background:linear-gradient(180deg,#fff9df,#fff)}.study-card.teal{background:linear-gradient(180deg,#effcfb,#fff)}.access-note{margin-top:28px;padding:16px 18px;border-radius:16px;background:#fff8dd;border:1px solid #f2df8c;color:#5a4b1b;font-size:.84rem}.book-grid [hidden],.quran-grid [hidden]{display:none!important}@media(max-width:820px){.source-hero,.quran-grid,.feature-grid,.study-grid{grid-template-columns:1fr}.book-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.section-head{align-items:start;flex-direction:column}}@media(max-width:520px){.book-grid{grid-template-columns:1fr}.quran-card{grid-template-columns:40px 1fr}.quran-card a{grid-column:2;justify-self:start}.arabic{float:none;display:block;margin-top:3px}.source-actions{min-width:0}}
</style>
