---
import MainLayout from '../../layouts/MainLayout.astro';
import CloudinaryUploader from '../../components/CloudinaryUploader.astro';
import { site, sitePath } from '../../data/site';
---
<MainLayout title="Media Center">
  <main>
    <section class="section">
      <div class="container admin-head">
        <a class="back" href={sitePath('/admin')}>← Kembali ke CMS</a>
        <span class="eyebrow">Media Center</span>
        <h1>Arsip Media PC Muhammadiyah Somagede</h1>
        <p>Unggah foto, video, audio, dan dokumen ke Cloudinary.</p>
      </div>
    </section>
    <section id="media-view" class="section section-alt" hidden>
      <div class="container">
        <CloudinaryUploader />
      </div>
    </section>
    <section id="media-login" class="section"><div class="container"><div class="notice"><strong>Login diperlukan.</strong> Silakan masuk melalui panel admin sebelum menggunakan Media Center.</div></div></section>
    <section class="section"><div class="container guide-grid">
      <article class="info-box"><span class="eyebrow">Alur arsip</span><h2>Media terpisah dari kode website</h2><p>GitHub menyimpan kode dan metadata konten. Cloudinary menyimpan file media agar repository tetap ringan.</p></article>
      <article class="info-box"><span class="eyebrow">Kontak organisasi</span><h2>{site.shortName}</h2><p>{site.address}</p><p>WhatsApp: {site.whatsapp.join(' · ')}</p></article>
    </div></section>
  </main>
</MainLayout>
<script is:inline>
const API='https://pcmsomagede-cms-api.pcmsomagede.workers.dev';const KEY='pcmsomagede.cms.token';const token=sessionStorage.getItem(KEY)||'';
(async()=>{if(!token){return}try{const r=await fetch(`${API}/api/session`,{headers:{Authorization:`Bearer ${token}`}});const d=await r.json();if(r.ok&&d.authenticated){document.querySelector('#media-login').hidden=true;document.querySelector('#media-view').hidden=false}}catch{}})();
</script>
<style>
  .admin-head{max-width:850px}.admin-head h1{margin:.35rem 0 .8rem}.admin-head p{max-width:760px;color:#5d697a;font-size:1.05rem}.back{display:inline-block;margin-bottom:1rem;color:#0b4da2;text-decoration:none;font-weight:700}.notice{padding:1rem 1.2rem;border-left:4px solid #b87900;background:#fff8e8;border-radius:8px;color:#5f4b20}.guide-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}@media(max-width:700px){.guide-grid{grid-template-columns:1fr}}
</style>
