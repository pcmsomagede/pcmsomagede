---
import MainLayout from '../../layouts/MainLayout.astro';
import { site, sitePath } from '../../data/site';
---
<MainLayout title="CMS Admin"><main><section class="section"><div class="container admin-shell">
<div id="login-view" class="login-card"><span class="eyebrow">CMS Admin</span><h1>Masuk Panel Editor</h1><p class="lead">Panel khusus pengelola Pimpinan Cabang Muhammadiyah Somagede.</p><form id="login-form"><label>Username<input id="username" autocomplete="username" required></label><label>Password<input id="password" type="password" autocomplete="current-password" required></label><button class="button primary" type="submit">Masuk</button><p id="login-error" class="error" hidden></p></form></div>
<div id="dashboard-view" hidden><span class="eyebrow">CMS Admin</span><h1>Panel Editor PC Muhammadiyah Somagede</h1><p class="lead">Kelola berita, kegiatan, agenda, dan media dari satu tempat.</p><div class="toolbar"><span class="session-ok">● Sesi aktif</span><button id="logout" class="button secondary">Keluar</button></div><div class="cms-grid"><a class="cms-card" href={`${sitePath('/admin/editor')}?type=berita`}><span>📰</span><strong>Berita</strong><small>Tulis artikel dan terbitkan.</small></a><a class="cms-card" href={`${sitePath('/admin/editor')}?type=kegiatan`}><span>📷</span><strong>Kegiatan</strong><small>Dokumentasi kegiatan.</small></a><a class="cms-card" href={`${sitePath('/admin/editor')}?type=agenda`}><span>📅</span><strong>Agenda</strong><small>Jadwal kegiatan.</small></a><a class="cms-card" href={sitePath('/admin/media')}><span>☁️</span><strong>Media Center</strong><small>Upload foto, video, MP3, dan PDF.</small></a></div><div class="quick-info"><div><span>Organisasi</span><strong>{site.shortName}</strong></div><div><span>Ketua</span><strong>{site.chair}</strong></div><div><span>WhatsApp</span><strong>{site.whatsapp.join(' · ')}</strong></div></div></div>
</div></section></main></MainLayout>
<script>
const API = 'https://pcmsomagede-cms-api.pcmsomagede.workers.dev';
const KEY = 'pcmsomagede.cms.token';
const initAdmin = () => {
  const loginView = document.querySelector('#login-view');
  const dashboard = document.querySelector('#dashboard-view');
  const form = document.querySelector('#login-form');
  const error = document.querySelector('#login-error');
  const logout = document.querySelector('#logout');
  if (!(loginView instanceof HTMLElement) || !(dashboard instanceof HTMLElement) || !(form instanceof HTMLFormElement) || !(error instanceof HTMLElement)) return;
  const show = () => { loginView.hidden = true; dashboard.hidden = false; };
  const token = () => sessionStorage.getItem(KEY) || '';
  const sessionRequest = async () => {
    const t = token();
    const headers: HeadersInit = t ? { Authorization: `Bearer ${t}` } : {};
    return fetch(`${API}/api/session`, { headers, credentials: 'include', cache: 'no-store' });
  };
  const check = async () => {
    try {
      const r = await sessionRequest();
      const d = await r.json().catch(() => ({}));
      if (r.ok && d.authenticated) show();
      else sessionStorage.removeItem(KEY);
    } catch { sessionStorage.removeItem(KEY); }
  };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.hidden = true;
    const button = form.querySelector('button[type="submit"]');
    const username = document.querySelector('#username');
    const password = document.querySelector('#password');
    if (!(button instanceof HTMLButtonElement) || !(username instanceof HTMLInputElement) || !(password instanceof HTMLInputElement)) return;
    button.disabled = true;
    button.textContent = 'Memeriksa...';
    try {
      const r = await fetch(`${API}/api/login`, {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify({ username: username.value.trim(), password: password.value }),
        credentials: 'include',
        cache: 'no-store'
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) {
        error.textContent = d.error || `Login gagal (${r.status}).`;
        error.hidden = false;
        return;
      }
      if (d.token) sessionStorage.setItem(KEY, d.token);
      const verified = await sessionRequest();
      const session = await verified.json().catch(() => ({}));
      if (verified.ok && session.authenticated) show();
      else {
        sessionStorage.removeItem(KEY);
        error.textContent = 'Login diterima tetapi sesi belum aktif. Muat ulang halaman lalu coba lagi.';
        error.hidden = false;
      }
    } catch (err) {
      console.error('CMS login request failed:', err);
      error.textContent = 'Tidak dapat terhubung ke server CMS.';
      error.hidden = false;
    } finally {
      button.disabled = false;
      button.textContent = 'Masuk';
    }
  });
  logout?.addEventListener('click', async () => {
    const t = token();
    try { await fetch(`${API}/api/logout`, { method: 'POST', headers: t ? { Authorization: `Bearer ${t}` } : {}, credentials: 'include' }); }
    finally { sessionStorage.removeItem(KEY); location.reload(); }
  });
  check();
};
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAdmin, { once: true }); else initAdmin();
</script>
<style>
.admin-shell{max-width:1000px}h1{margin:.35rem 0 .6rem}.lead{max-width:760px;color:#5d697a;font-size:1.05rem}.login-card{max-width:480px;margin:2rem auto;padding:2rem;background:#fff;border:1px solid #dbe2ec;border-radius:18px;box-shadow:0 12px 30px rgba(18,39,67,.07)}label{display:grid;gap:.4rem;margin:1rem 0;font-weight:650}input{width:100%;box-sizing:border-box;border:1px solid #cfd8e4;border-radius:9px;padding:.75rem .8rem;font:inherit}.button{border:0;border-radius:9px;padding:.75rem 1rem;font:inherit;font-weight:700;cursor:pointer}.button:disabled{opacity:.65;cursor:wait}.primary{background:#0b4da2;color:#fff}.secondary{background:#eef2f7;color:#26374b}.error{color:#a02f2f;background:#fff0f0;padding:.7rem;border-radius:8px}.toolbar{display:flex;justify-content:space-between;align-items:center;margin:1.2rem 0}.session-ok{color:#24633a;font-weight:700}.cms-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.5rem}.cms-card{display:grid;grid-template-columns:auto 1fr;column-gap:.9rem;align-items:center;padding:1.25rem;background:#fff;border:1px solid #dbe2ec;border-radius:16px;text-decoration:none;color:inherit}.cms-card span{grid-row:span 2;font-size:2rem}.cms-card strong{font-size:1.08rem}.cms-card small{color:#687386;margin-top:.2rem}.quick-info{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid #e3e8ef}.quick-info span{display:block;color:#778396;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.3rem}@media(max-width:700px){.cms-grid,.quick-info{grid-template-columns:1fr}}
</style>
