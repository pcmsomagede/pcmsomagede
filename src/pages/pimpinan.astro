---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import { leaders } from '../data/content';
---
<MainLayout title="Pimpinan">
  <PageHero eyebrow="Struktur" title="Pimpinan Cabang" description="Susunan pimpinan PC Muhammadiyah Somagede akan dilengkapi sesuai data resmi organisasi." />
  <main class="section"><div class="container"><div class="profile-grid">{leaders.map((leader) => <article class="profile"><div class="profile-avatar">{leader.name === '—' ? '…' : leader.name.split(' ').map((x) => x[0]).slice(0,2).join('')}</div><h3>{leader.name}</h3><p>{leader.role}</p></article>)}</div></div></main>
</MainLayout>
