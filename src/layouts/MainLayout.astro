---
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/header-redesign.css';

const { title = site.shortName, description = site.description } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const canonical = new URL(Astro.url.pathname, 'https://pcmsomagede.github.io').href;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06479b" />
    <link rel="icon" type="image/svg+xml" href={asset('logo-final.svg')} />
    <link rel="shortcut icon" type="image/svg+xml" href={asset('logo-final.svg')} />
    <link rel="apple-touch-icon" href={asset('logo-final.svg')} />
    <link rel="preload" as="image" href={asset(site.heroImage)} fetchpriority="high" />
    <link rel="canonical" href={canonical} />
    <title>{title} | PC Muhammadiyah Somagede</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
