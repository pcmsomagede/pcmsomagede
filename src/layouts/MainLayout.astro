---
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/fixes.css';
const { title = site.shortName, description = site.description } = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06479b" />
    <link rel="icon" type="image/webp" href={asset('logo.webp')} />
    <link rel="shortcut icon" type="image/webp" href={asset('logo.webp')} />
    <link rel="apple-touch-icon" href={asset('logo.webp')} />
    <link rel="canonical" href={site.url + (Astro.url.pathname.endsWith('/') ? Astro.url.pathname.slice(0, -1) : Astro.url.pathname)} />
    <title>{title} | PC Muhammadiyah Somagede</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
