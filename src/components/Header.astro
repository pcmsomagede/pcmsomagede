---
import { navItems, site } from '../data/site';
---
<header class="site-header">
  <div class="topbar-wrap">
    <div class="container topbar">
      <div>📍 {site.address}</div>
      <div class="top-contact">💬 {site.whatsapp[0]} · {site.whatsapp[1]}</div>
    </div>
  </div>
  <section class="masthead">
    <div class="masthead-photo" style={`background-image:linear-gradient(90deg,rgba(2,43,99,.98) 0%,rgba(2,43,99,.74) 36%,rgba(2,43,99,.08) 72%),url('${site.heroImage}')`} aria-hidden="true"></div>
    <div class="container masthead-content">
      <a class="brand-hero" href="/" aria-label={site.name}>
        <img src="/logo.svg" alt="Logo PC Muhammadiyah Somagede" />
        <div>
          <span>PIMPINAN CABANG</span>
          <strong>MUHAMMADIYAH<br />SOMAGEDE</strong>
          <b>KABUPATEN BANYUMAS</b>
          <small>Ketua: {site.chair}</small>
        </div>
      </a>
    </div>
  </section>
  <div class="nav-wrap">
    <div class="container nav-inner">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">☰ <span>Menu</span></button>
      <nav id="main-nav" aria-label="Navigasi utama">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('#main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle?.setAttribute('aria-expanded', String(open));
  });
</script>
