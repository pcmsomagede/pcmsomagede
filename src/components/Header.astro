---
import { navItems, site, sitePath } from '../data/site';
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<header class="site-header">
  <div class="topbar-wrap">
    <div class="container topbar">
      <div>📍 {site.address}</div>
      <div class="top-contact">💬 {site.whatsapp[0]} · {site.whatsapp[1]}</div>
    </div>
  </div>
  <section class="masthead">
    <img class="masthead-photo" src={site.heroImage} alt="Gedung dan lingkungan PC Muhammadiyah Somagede" loading="eager" />
    <div class="masthead-overlay" aria-hidden="true"></div>
    <div class="container masthead-content">
      <a class="brand-hero" href={sitePath('/')} aria-label={site.name}>
        <span class="brand-logo"><img src={asset('logo.webp')} alt="Logo PC Muhammadiyah Somagede" /></span>
        <div>
          <span>PIMPINAN CABANG</span>
          <strong>MUHAMMADIYAH<br />SOMAGEDE</strong>
          <b>KABUPATEN BANYUMAS</b>
          <small>Ketua: {site.chair}</small>
        </div>
      </a>
    </div>
  </section>
  <div class="nav-wrap">
    <div class="container nav-inner">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">☰ <span>Menu</span></button>
      <nav id="main-nav" aria-label="Navigasi utama">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('#main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    toggle?.setAttribute('aria-expanded', String(open));
  });
</script>
